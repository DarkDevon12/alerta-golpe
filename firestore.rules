// Regras do Firestore do AlertaGolpe.
// Publique em: Firebase Console → Firestore Database → Regras (cole este conteúdo)
// ou com a CLI: firebase deploy --only firestore:rules
//
// Resumo (LGPD): dados pessoais ficam em coleções que só o dono lê
// (usuarios, denuncias); o que é público (ranking, relatos) não tem nome,
// email, CPF nem uid de quem denunciou. A coleção cpfs só o servidor acessa
// (o firebase-admin ignora estas regras).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Qualquer sessão, inclusive a anônima da consulta grátis
    function autenticado() {
      return request.auth != null;
    }

    // Conta de verdade (email/senha ou Google), não a sessão anônima
    function logado() {
      return autenticado()
        && request.auth.token.firebase.sign_in_provider != "anonymous";
    }

    // Conta que já confirmou o email (contas Google já vêm confirmadas)
    function verificado() {
      return logado() && request.auth.token.email_verified == true;
    }

    function dono(uid) {
      return logado() && request.auth.uid == uid;
    }

    // ── usuarios/{uid}: dados privados ─────────────────────────────
    // Só o dono lê. Na criação (cadastro ou 1º login Google) grava só estes
    // campos, com o aceite dos termos carimbado pelo servidor. Não há CPF
    // aqui (fica só o hash protegido em cpfs) nem XP/moedas (ficam em
    // ranking, onde cada mudança é validada). Depois de criado, o cliente
    // não altera nem apaga: a exclusão é feita pelo servidor (/api/excluir-conta).
    match /usuarios/{uid} {
      allow read: if dono(uid);

      allow create: if dono(uid)
        && request.resource.data.keys().hasOnly(
          ["uid", "nome", "email", "dataCriacaoConta", "aceiteTermosEm", "versaoTermos", "loginGoogle"])
        && request.resource.data.keys().hasAll(
          ["uid", "nome", "email", "dataCriacaoConta", "aceiteTermosEm", "versaoTermos"])
        && request.resource.data.uid == uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 60
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.dataCriacaoConta == request.time
        && request.resource.data.aceiteTermosEm == request.time
        && request.resource.data.versaoTermos is string
        && request.resource.data.versaoTermos.size() <= 20;

      allow update, delete: if false;
    }

    // ── cpfs/{hmac}: ninguém acessa pelo cliente ───────────────────
    match /cpfs/{hash} {
      allow read, write: if false;
    }

    // ── ranking/{uid}: perfil público, ranking e loja ──────────────
    // Campos: apelido, anonimo, xp, denuncias, moedas, itens (comprados),
    // avatar, borda, tema, ultimaDenuncia, ultimaCompra. Nunca nome real,
    // email ou CPF. Qualquer usuário logado lê; cada um só escreve o seu, e só
    // por um destes caminhos: criar zerado, registrar uma denúncia, comprar
    // um item ou personalizar o perfil. Isso impede o cliente de inventar
    // XP, moedas ou nível.
    //
    // Catálogo: estes IDs, preços e XP mínimos repetem js/personalizacao.js.

    function gratis() {
      return ["iniciais", "escudo", "lupa", "cadeado", "olho", "raio", "coracao",
              "sem-borda", "escuro", "claro", "contraste"];
    }

    function precos() {
      return {
        "coroa": 30, "foguete": 30, "diamante": 30, "chama": 30, "estrela": 30, "lua": 30,
        "prata": 20, "ouro": 40, "neon": 60, "fogo": 80, "arco-iris": 100,
        "oceano": 50, "aurora": 50, "terminal": 80
      };
    }

    function porNivel() {
      return { "trofeu": 100, "bronze": 30, "lenda": 500 };
    }

    function camposPerfil() {
      return ["apelido", "anonimo", "xp", "denuncias", "moedas", "itens", "avatar", "borda", "tema",
              "ultimaDenuncia", "ultimaCompra"];
    }

    // Vazio (usa "Protetor #1234") ou 3 a 20 caracteres, sem email (@)
    // nem telefone (8 ou mais dígitos)
    function apelidoValido(apelido) {
      return apelido is string
        && (apelido.size() == 0
          || (apelido.size() >= 3 && apelido.size() <= 20
            && !apelido.matches('.*@.*')
            && !apelido.matches('.*[0-9][^0-9]*[0-9][^0-9]*[0-9][^0-9]*[0-9][^0-9]*[0-9][^0-9]*[0-9][^0-9]*[0-9][^0-9]*[0-9].*')));
    }

    // Item grátis, comprado ou liberado pelo XP
    function podeUsar(item, dados) {
      return item in gratis()
        || item in dados.itens
        || (item in porNivel() && dados.xp >= porNivel()[item]);
    }

    function alterou(campos) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos);
    }

    // +3 XP, +1 denúncia e +10 moedas, só se a denúncia citada em
    // ultimaDenuncia for criada neste mesmo envio (batch) e for do usuário
    function registraDenuncia(uid) {
      let depois = request.resource.data;
      let caminho = /databases/$(database)/documents/denuncias/$(depois.ultimaDenuncia);
      return verificado()
        && alterou(["xp", "denuncias", "moedas", "ultimaDenuncia"])
        && depois.xp == resource.data.xp + 3
        && depois.denuncias == resource.data.denuncias + 1
        && depois.moedas == resource.data.moedas + 10
        && depois.ultimaDenuncia is string
        && !exists(caminho)
        && existsAfter(caminho)
        && getAfter(caminho).data.usuario_uid == uid;
    }

    // Um item novo por vez, pagando o preço exato, sem ficar negativo
    function compraItem() {
      let depois = request.resource.data;
      let item = depois.ultimaCompra;
      return alterou(["moedas", "itens", "ultimaCompra"])
        && item in precos()
        && !(item in resource.data.itens)
        && depois.itens == resource.data.itens.concat([item])
        && depois.moedas == resource.data.moedas - precos()[item]
        && depois.moedas >= 0;
    }

    function personalizaPerfil() {
      let depois = request.resource.data;
      return alterou(["apelido", "anonimo", "avatar", "borda", "tema"])
        && apelidoValido(depois.apelido)
        && depois.anonimo is bool
        && podeUsar(depois.avatar, depois)
        && podeUsar(depois.borda, depois)
        && podeUsar(depois.tema, depois);
    }

    match /ranking/{uid} {
      allow read: if logado();

      // Sempre começa zerado (cadastro ou conta antiga sem entrada)
      allow create: if dono(uid)
        && request.resource.data.keys().hasOnly(camposPerfil())
        && request.resource.data.apelido == ""
        && request.resource.data.anonimo == false
        && request.resource.data.xp == 0
        && request.resource.data.denuncias == 0
        && request.resource.data.moedas == 0
        && request.resource.data.itens == []
        && request.resource.data.avatar == "iniciais"
        && request.resource.data.borda == "sem-borda"
        && request.resource.data.tema == "escuro";

      allow update: if dono(uid)
        && request.resource.data.keys().hasOnly(camposPerfil())
        && (registraDenuncia(uid) || compraItem() || personalizaPerfil());

      // Apagado só pelo servidor (/api/excluir-conta)
      allow delete: if false;
    }

    // ── denuncias/{uid}_{tipo}_{chave}: registro PRIVADO do autor ──
    // Só o autor lê (usuario_uid). O ID é "{uid}_{tipo}_{chave}" (ver
    // js/alvos.js): criar por cima de um documento existente conta como
    // update (proibido), então cada usuário só denuncia o mesmo
    // telefone/link/email uma vez, sem precisar de CPF.
    // Criação só com email confirmado, em nome próprio, e junto com o relato
    // público correspondente (relatoId). Imutável depois; apagada só pelo
    // servidor ao excluir a conta.
    match /denuncias/{id} {
      allow read: if logado() && resource.data.usuario_uid == request.auth.uid;

      allow create: if verificado()
        && request.resource.data.keys().hasOnly(
          ["telefone", "link", "email", "tipo", "chave", "descricao", "data", "usuario_uid", "analise_ia", "relatoId"])
        && request.resource.data.keys().hasAll(["tipo", "chave", "descricao", "data", "usuario_uid", "relatoId"])
        && request.resource.data.usuario_uid == request.auth.uid
        && request.resource.data.tipo in ["telefone", "link", "email"]
        && request.resource.data.chave is string
        && request.resource.data.chave.size() > 0
        && request.resource.data.chave.size() <= 300
        && id == request.auth.uid + "_" + request.resource.data.tipo + "_" + request.resource.data.chave
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() >= 20
        && request.resource.data.descricao.size() <= 500
        && request.resource.data.relatoId is string
        && existsAfter(/databases/$(database)/documents/relatos/$(request.resource.data.relatoId));

      allow update, delete: if false;
    }

    // ── relatos/{id}: versão PÚBLICA da denúncia, sem identificação ─
    // Alimenta a consulta (contagem e relatos). Não tem uid nem nome, e o ID
    // é aleatório, então ninguém descobre quem denunciou. Cada relato só
    // nasce junto com a denúncia privada do mesmo usuário (que garante uma
    // por alvo), por isso a contagem de relatos = usuários diferentes.
    // Qualquer sessão lê (a consulta grátis usa sessão anônima).
    match /relatos/{id} {
      allow read: if autenticado();

      allow create: if verificado()
        && request.resource.data.keys().hasOnly(["tipo", "valor", "chave", "descricao", "data"])
        && request.resource.data.tipo in ["telefone", "link", "email"]
        && request.resource.data.valor is string
        && request.resource.data.valor.size() > 0
        && request.resource.data.valor.size() <= 300
        && request.resource.data.chave is string
        && request.resource.data.chave.size() > 0
        && request.resource.data.chave.size() <= 300
        && request.resource.data.descricao is string
        && request.resource.data.descricao.size() >= 20
        && request.resource.data.descricao.size() <= 500
        && !exists(/databases/$(database)/documents/denuncias/$(request.auth.uid + "_" + request.resource.data.tipo + "_" + request.resource.data.chave))
        && existsAfter(/databases/$(database)/documents/denuncias/$(request.auth.uid + "_" + request.resource.data.tipo + "_" + request.resource.data.chave))
        && getAfter(/databases/$(database)/documents/denuncias/$(request.auth.uid + "_" + request.resource.data.tipo + "_" + request.resource.data.chave)).data.relatoId == id
        && getAfter(/databases/$(database)/documents/denuncias/$(request.auth.uid + "_" + request.resource.data.tipo + "_" + request.resource.data.chave)).data.descricao == request.resource.data.descricao;

      allow update, delete: if false;
    }
  }
}
